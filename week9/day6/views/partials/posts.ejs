<ul>
    <% posts.forEach(post => { %>
        <li>
            <h3><a href="<%= post.link %>" target="_blank" rel="noopener noreferrer"><%= post.title %></a></h3>
            <p><%= post.pubDate %></p>
            <p><%= post.contentSnippet || post.content || '' %></p>
        </li>
    <% }) %>
</ul>
